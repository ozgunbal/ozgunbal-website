# Google Cloud deployment settings used by .github/workflows/deploy.yml.
# Copy to .env, fill in the values, then push them to GitHub repository variables:
#   gh variable set -f .env
# None of these are secrets, but .env is gitignored so project-specific values stay local.
# The app itself needs no env vars at runtime; Cloud Run sets PORT automatically.

# Project ID (not the number), shown in Cloud overview → Dashboard → Project info
GCP_PROJECT_ID=your-project-id

# Region of the Artifact Registry repository and the Cloud Run service
GCP_REGION=europe-west1

# Artifact Registry Docker repository name
GCP_ARTIFACT_REPO=web

# Email of the deployer service account
GCP_SERVICE_ACCOUNT=github-deployer@your-project-id.iam.gserviceaccount.com

# Full provider path; uses the project NUMBER, not the project ID
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/000000000000/locations/global/workloadIdentityPools/github/providers/github-provider
